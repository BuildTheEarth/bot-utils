{
  "name": "@buildtheearth/bot-utils",
  "version": "1.2.1",
  "description": "A utility library for the bots!",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --fix",
    "format": "prettier --write -c src",
    "prepublish": "npm run pre-commit && npm run build",
    "generate-docs": "typedoc",
    "pre-commit": "npm run lint && npm run format && npm run generate-docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildTheEarth/bot-utils.git"
  },
  "author": "BuildTheEarth",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BuildTheEarth/bot-utils/issues"
  },
  "homepage": "https://github.com/BuildTheEarth/bot-utils#readme",
  "devDependencies": {
    "@types/lodash": "^4.14.179",
    "@types/ms": "^0.7.31",
    "@types/node": "^17.0.21",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "8.3.0",
    "prettier": "^2.5.1",
    "tsconfig-paths": "^3.13.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "discord.js": "^14.0.1",
    "globals": "^17.13.0",
    "json5": "^2.2.0",
    "lodash": "^4.17.21",
    "ms": "^2.1.3"
  }
}
